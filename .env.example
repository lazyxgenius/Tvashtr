# Copy to .env (gitignored) before running. Values must match docker-compose.yml.

# Shared Postgres URL (app via SQLAlchemy/Alembic + DBOS system tables).
# Bare postgresql:// scheme on purpose — DBOS and psql expect it; SQLAlchemy
# is pointed at psycopg 3 in code.
DATABASE_URL=postgresql://tvashtr:tvashtr@localhost:5433/tvashtr

# Consumed by docker-compose.yml for the postgres service.
POSTGRES_USER=tvashtr
POSTGRES_PASSWORD=tvashtr
POSTGRES_DB=tvashtr

# Optional: durable-sleep duration for the hello_durable spike (seconds).
# HELLO_SLEEP_SECONDS=10

# --- Model Gateway provider keys (P0.2) ---
# Secrets live here only; never commit a real key. The gateway reads these from
# the environment via LiteLLM. OpenRouter is the default and reaches Llama/
# Gemini/GPT/etc. with a single key; the others are only needed if you route to
# those providers directly (e.g. via model_fallbacks). Uncomment + fill to use.
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# HUGGINGFACE_API_KEY=

# --- LiteLLM proxy (P1.4a — the agent-internal spend chokepoint) ---
# The proxy is a docker-compose sibling to Postgres (see docker-compose.yml + litellm/
# config.yaml). It is OPT-IN: with LITELLM_PROXY_ENABLED unset/0 the agent talks to
# OpenRouter directly, exactly as before. To enable it, set BOTH lines below TOGETHER:
#   - LITELLM_PROXY_ENABLED=1 routes the agent's own LLM calls through the proxy.
#   - LITELLM_MASTER_KEY is REQUIRED and must be the SAME value the proxy authenticates with
#     (it feeds both the proxy container AND the agent's api_key). docker-compose.yml defaults
#     the proxy to `sk-tvashtr-local-dev` so it boots healthy with no .env — but the agent only
#     authenticates if you set this to match (otherwise every agent call 401s). Use a strong
#     value for anything beyond your machine; the proxy port is reachable on all interfaces.
# The proxy reaches OpenRouter with the OPENROUTER_API_KEY above.
# LITELLM_MASTER_KEY=sk-tvashtr-local-dev
# LITELLM_PROXY_ENABLED=1
# Optional overrides (defaults shown): port 4000; local host 127.0.0.1; docker host
# host.docker.internal (how the containerized agent reaches the host-published proxy port).
# LITELLM_PROXY_PORT=4000
# LITELLM_PROXY_HOST_LOCAL=127.0.0.1
# LITELLM_PROXY_HOST_DOCKER=host.docker.internal

# --- Fly microVM sandbox (M-h2a — the HOSTED agent-execution substrate) ---
# Set TVASHTR_AGENT_SANDBOX=fly to run each run's agent inside a throwaway Fly Firecracker
# microVM (ONE machine per RUN) instead of a local Docker container. The default stays `docker`;
# `local`/`docker` are completely unaffected by anything below.
#
# TVASHTR_FLY_API_TOKEN is an org-scoped Fly API token and is a SECRET — never commit a real one.
# Without it the live `make github-pr-fly-e2e` gate SKIPS cleanly (it is not a failure), and the
# offline suite never touches Fly at all (every unit test fakes the API).
#
# REACHING THE SANDBOX FROM A LAPTOP: the run app is reached over a private `.flycast` address, so
# a WireGuard tunnel to the Fly org must be ACTIVE for a local backend to dial it. Verify with:
#   dig @fdaa:<network-id>::3 _apps.internal txt +short
# TVASHTR_FLY_API_TOKEN=
# TVASHTR_FLY_ORG=personal
# TVASHTR_FLY_REGION=bom
#
# The agent-server image the microVM boots. Defaults to a DIGEST PIN of the same image the docker
# path is proven on — deliberately not a moving `:latest` tag, because a Fly host pulls fresh on
# every cold boot and `latest` silently outruns the pinned openhands-sdk (a newer server's events
# carry fields the older client rejects). Re-pin in lockstep with the SDK. Set this to point Fly at
# a slim image (THE cost lever: the default bakes in VSCode + VNC that are never opened, and on Fly
# that weight is paid on every cold host); set it EMPTY to just track TVASHTR_AGENT_SERVER_IMAGE.
# TVASHTR_FLY_AGENT_IMAGE=
#
# Guest size, tunable from the live gate's measured peak-memory reading.
# KEEP MEMORY <= 2048: Fly refuses to SUSPEND a machine larger than 2 GB, and M-h2b suspends the
# machine while a run is parked at a human gate so it bills storage-only instead of CPU/RAM. The
# default is 1024 (M-h2a measured a 570 MB peak). Raising it past 2048 silently forfeits suspend.
# TVASHTR_FLY_GUEST_CPUS=1
# TVASHTR_FLY_GUEST_MEMORY_MB=1024
#
# M-h2b — the secret the per-run agent-server key is DERIVED from: HMAC-SHA256(secret, run_id).
# This is what makes a hosted run survive the backend dying: a restarted process re-cuts the exact
# same key from the run_id, so it can re-attach to the still-alive microVM WITHOUT the key ever
# having been written to the database, a log line, or a workflow checkpoint.
# MUST be strong AND STABLE in production — rotating it while runs are parked at a gate strands
# those sandboxes behind a key nobody can re-derive (they fail closed). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# TVASHTR_FLY_SESSION_SECRET=
