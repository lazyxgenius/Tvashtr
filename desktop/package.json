{
  "name": "tvashtr-desktop",
  "version": "0.6.0",
  "private": true,
  "description": "Tvashtr Desktop v1 \u2014 Electron shell around the existing React/Vite frontend (hosted API).",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "start": "node scripts/start.mjs",
    "electron": "electron .",
    "test": "node scripts/run-tests.cjs",
    "dist:mac": "CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac dmg --publish never",
    "pack:mac": "npm run build && npm run dist:mac"
  },
  "dependencies": {
    "express": "^4.21.2",
    "http-proxy-middleware": "^3.0.5"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "build": {
    "appId": "dev.tvashtr.desktop",
    "productName": "Tvashtr",
    "copyright": "Copyright \u00a9 Tvashtr",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "scripts/local-server.cjs",
      "dist-fe/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "protocols": [
      {
        "name": "Tvashtr",
        "schemes": [
          "tvashtr"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "artifactName": "Tvashtr-mac.${ext}"
    },
    "dmg": {
      "title": "Tvashtr",
      "writeUpdateInfo": false
    },
    "publish": null
  }
}
